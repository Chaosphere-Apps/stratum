# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS ui-build

WORKDIR /src/ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/index.html ui/tsconfig.json ui/tsconfig.node.json ui/vite.config.ts ./
COPY ui/src ./src

RUN npm run build

FROM golang:1.25-alpine AS backend-build

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/cmd ./cmd
COPY backend/internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/stratum ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=backend-build /out/stratum /stratum
COPY --from=ui-build /src/ui/dist /public

EXPOSE 8080

ENV BACKEND_ADDR=:8080
ENV STATIC_ASSETS_DIR=/public

ENTRYPOINT ["/stratum"]
