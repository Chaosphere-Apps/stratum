# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM node:22-alpine AS ui-build

WORKDIR /src/ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/index.html ui/tsconfig.json ui/tsconfig.node.json ui/vite.config.ts ./
COPY ui/src ./src

RUN npm run build \
  && find dist -type f \( -name '*.map' -o -name '*.ts' -o -name '*.tsx' \) -delete

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend-build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/cmd ./cmd
COPY backend/internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/stratum ./cmd/server \
  && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=backend-build /out/stratum /stratum
COPY --from=backend-build /out/migrate /migrate
COPY --from=ui-build /src/ui/dist /public

EXPOSE 8080

ENV BACKEND_ADDR=:8080
ENV STATIC_ASSETS_DIR=/public

ENTRYPOINT ["/stratum"]
